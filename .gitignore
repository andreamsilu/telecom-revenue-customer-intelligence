# Generated data (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Optional: reference data may be regenerated; keep structure
# Uncomment if generated reference files should not be committed:
# data/reference/*
# !data/reference/.gitkeep

